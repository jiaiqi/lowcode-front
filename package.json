{
  "name": "lowcode-front",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "低代码渲染与编辑独立工程（Vite + Vue2.7）",
  "scripts": {
    "dev": "vite",
    "dev:park": "vite --mode park",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:dev": "vite build --mode dev",
    "prepare": "husky",
    "lint": "eslint src --ext .js,.vue --max-warnings=999",
    "lint:fix": "eslint src --ext .js,.vue --fix",
    "format": "prettier --write \"src/**/*.{js,vue,scss,json}\""
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@iconify-json/ep": "^1.2.0",
    "@iconify-json/material-symbols": "^1.2.0",
    "@iconify-json/mdi-light": "^1.2.0",
    "@iconify-json/ri": "^1.2.0",
    "@iconify/json": "^2.2.333",
    "animate.css": "^4.1.1",
    "axios": "^1.3.4",
    "dayjs": "^1.11.18",
    "echarts": "^4.8.0",
    "echarts-liquidfill": "^2.0.6",
    "echarts-wordcloud": "^1.1.3",
    "element-ui": "2.15.14",
    "jquery": "^3.6.4",
    "lodash": "^4.17.21",
    "vue": "2.7.16",
    "vue-drag-resize": "^1.5.4",
    "vue-fragment": "^1.6.0",
    "vue-grid-layout": "^2.4.0",
    "vue-json-viewer": "2",
    "vue-router": "3.0.3",
    "vue-sketch-ruler": "^1.0.3",
    "vue2-teleport": "^1.1.4",
    "vuedraggable": "^2.24.3",
    "vuex": "3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@unocss/preset-icons": "^66.7.5",
    "@vitejs/plugin-vue2": "^2.3.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "sass": "1.80.0",
    "unocss": "^66.7.5",
    "vite": "^5.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,json,md}": [
      "prettier --write"
    ]
  }
}
